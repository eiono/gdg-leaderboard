{
  "sheet_csv_env": "SHEET_CSV_URL",
  "name_column": ["User Name", "Name"],
  "url_column": ["Google Skills Profile URL", "URL"],

  "solutions_columns": {
    "course_url": "Links",
    "title": "Topic",
    "solution": "Solution link"
  },

  "max_workers": 3,
  "request_delay_seconds": 1.5,
  "request_timeout_seconds": 20,
  "max_retries": 2,

  "skip_completed_students": true,
  "recheck_failed_every_hours": 24,

  "allowed_profile_domains": [
    "www.skills.google",
    "skills.google",
    "www.cloudskillsboost.google",
    "cloudskillsboost.google"
  ],

  "user_agent": "Mozilla/5.0 (compatible; CommunityLeaderboardBot/1.0)",

  "tracks": [
    {
      "id": "student",
      "label": "Students",
      "sheet_csv_env": "SHEET_CSV_URL",
      "solutions_csv_env": "STUDENT_SOLUTIONS_CSV_URL",
      "syllabus": "config/syllabus.json",
      "output": "web/public/data/leaderboard.json"
    },
    {
      "id": "developer",
      "label": "Developers",
      "sheet_csv_env": "DEV_SHEET_CSV_URL",
      "solutions_csv_env": "DEV_SOLUTIONS_CSV_URL",
      "syllabus": "config/syllabus_developer.json",
      "output": "web/public/data/developers.json"
    }
  ],

  "paths": {
    "syllabus": "config/syllabus.json",
    "output": "web/public/data/leaderboard.json",
    "log": "logs/last_run.json"
  }
}
